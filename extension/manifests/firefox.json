{
  "manifest_version": 3,
  "name": "ECX Wallet",
  "version": "0.0.1",
  "description": "Wallet Base for eCash (ECX) drivechains.",
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "ECX Wallet",
    "default_popup": "index.html?view=popup"
  },
  "sidebar_action": {
    "default_title": "ECX Wallet",
    "default_panel": "index.html?view=panel",
    "open_at_install": false
  },
  "permissions": ["storage", "alarms"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["inpage.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "wallet@ecx.invalid",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
