{
  "manifest_version": 3,
  "name": "ECX Wallet",
  "version": "0.0.1",
  "description": "Wallet Base for eCash (ECX) drivechains.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ECX Wallet",
    "default_popup": "index.html?view=popup"
  },
  "side_panel": {
    "default_path": "index.html?view=panel"
  },
  "permissions": ["storage", "alarms", "sidePanel"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["inpage.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
